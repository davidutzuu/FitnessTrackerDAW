<div class="card shadow p-4 mt-4">
    <h2 class="text-center text-primary mb-4">Catalogul de Exerciții (Componentă SPA Modernă)</h2>
    <div id="react-root"></div>
</div>

<script src="https://unpkg.com/react@18/umd/react.development.js"></script>
<script src="https://unpkg.com/react-dom@18/umd/react-dom.development.js"></script>
<script src="https://unpkg.com/babel-standalone@6/babel.min.js"></script>

<script type="text/babel">
    function ExerciseApp() {
        const [exercises, setExercises] = React.useState([]);
        const [loading, setLoading] = React.useState(true);
        const [error, setError] = React.useState(null);

        React.useEffect(() => {
            // Consumam API-ul nativ REST creat anterior
            fetch('/api/Exercise')
                .then(response => {
                    if (!response.ok) throw new Error('Eroare la preluarea datelor de la API.');
                    return response.json();
                })
                .then(data => {
                    setExercises(data);
                    setLoading(false);
                })
                .catch(err => {
                    setError(err.message);
                    setLoading(false);
                });
        }, []);

        if (loading) return <div class="text-center p-4"><div class="spinner-border text-primary" role="status"></div><p class="mt-2">Se încarcă datele din API...</p></div>;
        if (error) return <div class="alert alert-danger" role="alert">A apărut o eroare: {error}</div>;

        return (
            <div>
                <p class="text-muted mb-3">Această secțiune este randată dinamic pe client utilizând un framework SPA și consumă endpoint-ul securizat.</p>
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>#ID</th>
                                <th>Denumire Exercițiu</th>
                                <th>Grupă de Mușchi Vizată</th>
                            </tr>
                        </thead>
                        <tbody>
                            {exercises.length === 0 ? (
                                <tr><td colSpan="3" class="text-center text-muted">Nu există exerciții globale adăugate de administrator.</td></tr>
                            ) : (
                                exercises.map(ex => (
                                    <tr key={ex.id}>
                                        <td><strong>{ex.id}</strong></td>
                                        <td>{ex.name}</td>
                                        <td><span class="badge bg-success">{ex.targetMuscle}</span></td>
                                    </tr>
                                ))
                            )}
                        </tbody>
                    </table>
                </div>
            </div>
        );
    }

    const root = ReactDOM.createRoot(document.getElementById('react-root'));
    root.render(<ExerciseApp />);
</script>