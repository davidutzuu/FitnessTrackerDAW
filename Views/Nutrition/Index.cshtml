@model IEnumerable<FitnessTrackerPAW.Application.DTOs.SupplementDto>

@{
    ViewData["Title"] = "Tracking Macronutrienți";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-4">
            <div class="card shadow-sm text-dark bg-light mb-4">
                <div class="card-header bg-dark text-white fw-bold">
                    <i class="fas fa-plus-circle me-2"></i>Adaugă Aliment / Supliment
                </div>
                <div class="card-body">
                    <form asp-controller="Nutrition" asp-action="AddMacro" method="post">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Denumire (ex: Serious Mass Gainer)</label>
                            <input type="text" name="name" class="form-control" placeholder="Introdu numele..." required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Calorii (Kcal)</label>
                            <input type="number" name="calories" class="form-control" min="0" placeholder="ex: 1250" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Proteine (g)</label>
                            <input type="number" step="0.1" name="protein" class="form-control" min="0" placeholder="ex: 50" required />
                        </div>
                        <div class="form-check mb-3">
                            <input type="checkbox" name="isMassGainer" value="true" class="form-check-input" id="massGainerCheck" />
                            <label class="form-check-label text-muted" for="massGainerCheck">Este supliment tip Mass Gainer?</label>
                        </div>
                        <button type="submit" class="btn btn-primary w-100 fw-bold">Salvează în Jurnal</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="row mb-4 text-center">
                <div class="col-6">
                    <div class="card border-warning shadow-sm">
                        <div class="card-body">
                            <h6 class="text-muted text-uppercase small">Total Calorii Salvate</h6>
                            <h2 class="text-warning fw-bold">@ViewBag.TotalCalories Kcal</h2>
                        </div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="card border-success shadow-sm">
                        <div class="card-body">
                            <h6 class="text-muted text-uppercase small">Total Proteine Salvate</h6>
                            <h2 class="text-success fw-bold">@ViewBag.TotalProtein g</h2>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-header bg-secondary text-white fw-bold d-flex justify-content-between align-items-center">
                    <span><i class="fas fa-list me-2"></i>Alimentele consumate astăzi</span>
                    <button type="button" class="btn btn-danger btn-sm" onclick="resetSupplements()" title="Sterge ALL supplements si reseteaza calorii/proteine la 0">
                        <i class="fas fa-trash-alt me-1"></i>RESET
                    </button>
                </div>
                <div class="card-body p-0">
                    <table class="table table-hover table-striped mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>Produs / Aliment</th>
                                <th class="text-center">Calorii</th>
                                <th class="text-center">Proteine</th>
                                <th class="text-center">Tip</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Any())
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-4">Nu ai adăugat niciun macronutrient astăzi. Începe din formularul din stânga!</td>
                                </tr>
                            }
                            else
                            {
                                foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="fw-bold">@item.Name</td>
                                        <td class="text-center text-warning fw-bold">@item.CaloriesPerServing Kcal</td>
                                        <td class="text-center text-success fw-bold">@item.ProteinPerServing g</td>
                                        <td class="text-center">
                                            @if (item.IsMassGainer)
                                            {
                                                <span class="badge bg-danger">Mass Gainer</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-info text-dark">Aliment Standard</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // ↑ JAVASCRIPT: Functia pentru RESET
    async function resetSupplements() {
        // ↑ Functia care sterge toti suplimentele

        // Confirm dialog
        if (!confirm("Esti sigur ca vrei sa stergi TOTI suplimentele si sa resetezi calorii/proteine la 0?")) {
            // ↑ Afiseaza dialog de confirm
            // Daca utilizatorul apasa CANCEL → return (nu se executa nothing)
            return;
        }

        try {
            // Apeleaza API endpoint: DELETE /api/supplement/reset
            const response = await fetch('/api/supplement/reset', {
                method: 'DELETE',
                // ↑ HTTP METHOD = DELETE

                headers: {
                    'Content-Type': 'application/json'
                    // ↑ Header: JSON response
                }
            });

            // Verifica daca request-ul e ok (200-299)
            if (response.ok) {
                // ↑ Daca STATUS = 200, 201, 204, etc.

                // Afiseaza success message
                alert('✓ Toti suplimentele au fost sterse! Calorii si proteine reserate la 0.');
                // ↑ Alert cu mesaj de succes

                // Reincarca pagina (refresh)
                location.reload();
                // ↑ Reincarca View - tabelul va fi gol, totale vor fi 0
            } else {
                // ↑ Daca STATUS = 400, 403, 404, 500, etc.

                const errorData = await response.json();
                // ↑ Preia JSON response din server

                alert('❌ Eroare: ' + (errorData.message || 'Nu s-a putut reseta suplimentele.'));
                // ↑ Afiseaza eroare
            }
        } catch (error) {
            // ↑ Catch errors (network, JSON parse, etc.)

            console.error('Eroare:', error);
            // ↑ Logheza eroare in console

            alert('❌ Eroare de retea: ' + error.message);
            // ↑ Afiseaza eroare utilizatorului
        }
    }
    // ↑ Inchide functia resetSupplements
</script>
