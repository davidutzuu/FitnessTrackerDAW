@if (User.Identity != null && User.Identity.IsAuthenticated)
{
    <ul class="navbar-nav">
        <li class="nav-item mt-1 me-3">
            <span class="nav-link text-white fw-bold">
                Salut, @User.Identity.Name!
            </span>
        </li>
        <li class="nav-item mt-1">
            <form class="form-inline" asp-controller="Account" asp-action="Logout" method="post">
                <button type="submit" class="nav-link btn btn-outline-danger text-white fw-bold px-3 py-1 border-0">
                    <i class="fas fa-sign-out-alt me-1"></i> Logout
                </button>
            </form>
        </li>
    </ul>
}
else
{
    <ul class="navbar-nav">
        <li class="nav-item ms-2 mt-1">
            <a class="nav-link text-white" asp-controller="Account" asp-action="Register">Înregistrare</a>
        </li>
        <li class="nav-item ms-2 mt-1">
            <a class="nav-link btn btn-primary text-white fw-bold px-3 py-1" asp-controller="Account" asp-action="Login">
                Autentificare
            </a>
        </li>
    </ul>
}